{
  "name": "aurora-vida-app",
  "version": "1.0.0-hu01",
  "description": "API de Aurora Vida (venta digital de seguro de vida temporal) para el semillero QE",
  "private": true,
  "type": "commonjs",
  "main": "dist/app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --packages=external --minify --outfile=dist/app.js",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validar-contrato": "npx --yes @redocly/cli@latest lint openapi/openapi.yaml"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "express": "^4.21.2",
    "express-openapi-validator": "^5.3.9",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "esbuild": "^0.24.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
